{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K12 Lesson Studio Offline Interactive Theater Config (v5.1)",
  "type": "object",
  "required": ["title", "brandTitle", "brandSub", "brandTag", "films", "teams", "questions"],
  "properties": {
    "title": { "type": "string" },
    "brandTitle": { "type": "string" },
    "brandSub": { "type": "string" },
    "brandTag": { "type": "string" },
    "theme": {
      "description": "Preset subject name (math|chinese|english|science|physics|chemistry|biology|history|geography) or CSS custom property dict",
      "oneOf": [{ "type": "string" }, { "type": "object" }]
    },
    "videoCaption": { "type": "string", "default": "3D 代码演示 · 离线直放" },
    "films": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["num", "name", "eyebrow", "title", "desc"],
        "properties": {
          "num": { "type": "string", "description": "2-digit scene number e.g. '01'" },
          "name": { "type": "string", "description": "Short tab label e.g. '激光聚焦'" },
          "eyebrow": { "type": "string" },
          "title": { "type": "string" },
          "desc": { "type": "string" },
          "dur": { "type": "number", "default": 12 },
          "isVideo": { "type": "boolean", "default": false },
          "beats": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string" },
            "description": "4 keyframe labels along timeline e.g. ['1 入射', '2 折射', '3 聚焦', '4 公式']"
          },
          "cues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["t0", "a", "b"],
              "properties": {
                "t0": { "type": "number", "minimum": 0, "maximum": 1 },
                "a": { "type": "string", "description": "Subtitle badge" },
                "b": { "type": "string", "description": "Subtitle line" }
              }
            }
          }
        }
      }
    },
    "teams": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "color"],
        "properties": {
          "name": { "type": "string" },
          "short": { "type": "string", "description": "Short badge label (alias: tag)" },
          "color": { "type": "string", "description": "Hex color e.g. #38BDF8 (alias: c)" }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["stem", "opts", "a", "steps"],
        "properties": {
          "tag": { "type": "string" },
          "stem": { "type": "string" },
          "opts": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "a": { "type": "integer", "minimum": 0 },
          "answerText": { "type": "string" },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
