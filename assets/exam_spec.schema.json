{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K12 Lesson Studio Exam & Grading Spec (v5.1)",
  "type": "object",
  "required": ["title", "sections"],
  "properties": {
    "title": { "type": "string", "description": "Exam title" },
    "duration_min": { "type": "integer", "default": 40 },
    "target_total": { "type": "number", "default": 100 },
    "notice": { "type": "string", "description": "Subject boundary or constant rule, e.g. π取3.14" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "items"],
        "properties": {
          "title": { "type": "string" },
          "section_points": { "type": "number" },
          "instruction": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["points", "stem", "answer"],
              "properties": {
                "id": { "type": "string" },
                "points": { "type": "number", "exclusiveMinimum": 0 },
                "stem": { "type": "string" },
                "options": { "type": "array", "items": { "type": "string" } },
                "answer_lines": { "type": "integer", "minimum": 0, "default": 0 },
                "answer": { "type": "string" },
                "analysis": { "type": "string" },
                "rubric": { "type": "string" },
                "pitfall": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
